+const SUMMARY_MD = resolve(ROOT, 'reports', `linkedin-batch-${DATE}-summary.md`);
+
+/** @type {Record<string, string>} */
+const HOST_TO_COMPANY = {
+  'careers.na.panasonic.com': 'Panasonic',
