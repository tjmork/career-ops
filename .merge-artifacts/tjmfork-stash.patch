+
+// ══════════════════════════════════════════════════════════════════════
+// PART 10: config.enabled: true (explicit)
+// ══════════════════════════════════════════════════════════════════════
+
+section('buildTrustValidator — explicit enabled: true');
+
+{
+  const v = buildTrustValidator({ enabled: true });
