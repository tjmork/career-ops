+│   ├── _shared.md               # السياق البرمجي العام وقواعد التقييم
+│   ├── oferta.md                # منطق تقييم عرض عمل فردي
+│   ├── pdf.md                   # منطق توليد وتعديل ملف السيرة الذاتية
+│   ├── scan.md                  # إعدادات وعمليات مسح منصات التوظيف
+│   └── ...
