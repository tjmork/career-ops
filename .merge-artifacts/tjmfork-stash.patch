+assert(validateUrl('file:///etc/passwd').valid === false, 'file: protocol is invalid');
+assert(validateUrl('data:text/html,<h1>hi</h1>').valid === false, 'data: protocol is invalid');
+
+// ══════════════════════════════════════════════════════════════════════
+// PART 3: matchesDomainList
+// ══════════════════════════════════════════════════════════════════════
