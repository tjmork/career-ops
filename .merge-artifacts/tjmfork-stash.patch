+}
+
+// Try __NEXT_DATA__ style
+const nd = s.match(/<script id="__NEXT_DATA__"[^>]*>([\s\S]*?)<\/script>/);
+if (nd) {
+  try {
+    const j = JSON.parse(nd[1]);
