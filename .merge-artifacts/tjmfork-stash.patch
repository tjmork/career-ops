+      .replace(/\s+/g, ' ')
+      .trim()
+      .replace(/[. ]+$/g, '') || 'Unknown-Company'
+  );
+}
+
+export function companyFolderForSlug(slug) {
+  const raw = SLUG_TO_COMPANY_FOLDER[slug];
+  if (!raw) {
+    throw new Error(
+      `[output] Unknown variant slug "${slug}". Add SLUG_TO_COMPANY_FOLDER["${slug}"] in output-company-folders.mjs.`
