+  "Responsibilities",
+  "Qualifications",
+  "Required",
+  "Trimble",
+  "Westminster",
+]) {
+  const i = s.indexOf(needle);
+  if (i >= 0) console.log(needle, "at", i, s.slice(i, i + 400).replace(/\s+/g, " "));
+}
+
+const keys = [
+  "encodedHtmlDescription",
+  "htmlDescription",
+  "job_description",
+  "jobDescription",
+  "posting",
+  "qualifications",
+  "responsibility",
+  "jobReqId",
+  "department",
+];
+for (const k of keys) {
+  let idx = 0;
+  let c = 0;
